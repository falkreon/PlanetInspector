{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"name": "Planets World File",
	"description": "The .mp_world file format",
	
	"$defs": {
		"MessyBool": {
			"description": "Boolean that often shows up as an integer or double in the file",
			"oneOf": [
				{ "type": "boolean" },
				{ "const": 0, "title": "false" },
				{ "const": 1, "title": "true" }
			]
		}
	},
	
	
	
	"type": "object",
	"properties": {
		"MODES": { "type": "array" },
		"LOGS": { "type": "array" },
		"SECTORS": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"description": "The name of the Sector.",
						"type": "string"
					},
					"x": {
						"description": "The number of screens from the left of the Sector map to the left edge of the Sector.",
						"type": "integer"
					},
					"y": {
						"description": "The number of screens from the top of the Sector map to the top edge of the Sector.",
						"type": "integer"
					},
					"width": {
						"description": "The number of screens wide the Sector is. Also affects the in-sector map of Areas.",
						"type": "integer"
					},
					"height": {
						"description": "The number of screens tall the Sector is. Also affects the in-sector map of Areas.",
						"type": "integer"
					},
					"connections": {
						"description": "A list of sector Ids for other Sectors this Sector has teleport connections to.",
						"type": "array",
						"items": {
							"type": "integer"
						}
					},
					"elevator_screens": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"x": {
									"description": "The x coordinate of the elevator screen relative to the Sector x.",
									"type": "integer"
								},
								"y": {
									"description": "The y coordinate of the elevator screen relative to the Sector y.",
									"type": "integer"
								}
							},
							"required": [ "x", "y" ]
						}
					}
				},
				"required": [ "x", "y", "width", "height", "connections", "elevator_screens" ],
				"additionalProperties": false
			}
		},
		"TIMERS": { "type": "array" },
		"AREAS": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"description": "The name of the Area",
						"type": "string"
					},
					"color": {
						"description": "A color, in packed 8.8.8 BGR integer format.",
						"type": "integer"
					},
					"bgm": {
						"description": "The name of the default background music track for the Area. Rooms that specify the empty string as their music will use this track instead.",
						"type": "string"
					}
				},
				"required": [ "name", "color", "bgm" ],
				"additionalProperties": false
			}
		},
		"ROOMS": {
			"type": "array",
			"items": {
				"$ref": "mp_room.json"
			}
		},
		
		"HAZARDS": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"touch": { "$ref": "#/$defs/MessyBool" },
					"suffocating": { "$ref": "#/$defs/MessyBool" },
					"corrupting": { "$ref": "#/$defs/MessyBool" },
					"air": { "$ref": "#/$defs/MessyBool" },
					"disabling_flags": { "type": "array" },
					"visual_color": { "type": "integer" },
					"name": { "type": "string" },
					"damage": { "type": "integer" },
					"visual_style": { "type": "integer" }
				},
				"required": [
					"touch", "suffocating", "corrupting", "air", "disabling_flags", "visual_color", "name",
					"damage", "visual_style"
				],
				"additionalProperties": false
			}
		},
		
		"OBJECTIVES": {
			"type": "object",
			"properties": {
				"enabled": { "$ref": "#/$defs/MessyBool" },
				"required": {
					"description": "Type uncertain! It's 1.0 in practice!",
					"$ref": "#/$defs/MessyBool"
				},
				"list": { "type": "array" }
			},
			"required": [ "enabled" , "required", "list" ],
			"additionalProperties": false
		},
		"RULES": {
			"type": "object",
			
			"properties": {
				"ammo_refills": { "$ref": "#/$defs/MessyBool" },
				"energy_refills": { "$ref": "#/$defs/MessyBool" },
				"route_replay": { "$ref": "#/$defs/MessyBool" },
				"enemy_random_spawning": { "$ref": "#/$defs/MessyBool" },
				"map_revealed": { "$ref": "#/$defs/MessyBool" },
				"room_info_show_popup": { "$ref": "#/$defs/MessyBool" },
				"room_info_show_on_map": { "$ref": "#/$defs/MessyBool" },
				"auto_map": { "$ref": "#/$defs/MessyBool" },
				"freeze_effect_time_by_hazard": { "$ref": "#/$defs/MessyBool" },
				"boss_missiles": { "$ref": "#/$defs/MessyBool" },
				"show_boss_energy": { "$ref": "#/$defs/MessyBool" },
				"room_info_show_designers": { "$ref": "#/$defs/MessyBool" },
				"route_replay_reveal_all": { "$ref": "#/$defs/MessyBool" },
				
				
				"door_red_health": { "type": "integer" },
				"door_purple_health": { "type": "integer" },
				"magnet_energize_time": { "type": "integer" },
				"block_crumble_time": { "type": "integer" },
				"freeze_effect_time": { "type": "integer" },
				"block_reform_time": { "type": "integer" },
				
				"enemy_random_spawn_rate": { "type": "integer" },
				"enemy_death_memory_distance": { "type": "integer" },
				"enemy_death_memory_time": { "type": "integer" },
				"enemy_death_recovery_time": { "type": "integer" },
				
				"map_scanner_size": { "type": "integer" },
				"map_scanner_time": { "type": "integer" },
				
				"room_info_indicate_major": { "description": "Data type unknown", "default": 0 },
				"save_style": { "description": "Data type unknown", "default": 0 },
				"enemy_death_memory": { "description": "Data type unknown", "default": 0 },
				
				"map_marker_icons": {
					"type": "array",
					"items": {
						"type": "integer"
					}
				}
			},
			"required": [
				"energy_refills", "route_replay", "door_red_health", "magnet_energize_time", "ammo_refills",
				"enemy_death_memory_distance", "enemy_random_spawning", "map_revealed", "room_info_show_popup",
				"door_purple_health", "auto_map", "block_crumble_time", "freeze_effect_time_by_hazard",
				"save_style", "enemy_death_memory", "enemy_random_spawn_rate", "map_scanner_size", "boss_missiles",
				"room_info_show_on_map", "map_marker_icons", "show_boss_energy", "freeze_effect_time",
				"block_reform_time", "room_info_show_designers", "route_replay_reveal_all", "enemy_death_memory_time",
				"room_info_indicate_major", "map_scanner_time"
			],
			"additionalProperties": false
		},
		
		"LIQUIDS_DAMAGE": {
			"type": "array",
			"items": { "type": "integer" }
		},
		
		"SAMUS": {
			"type": "object",
			"properties": {
				"ammo": {
					"type": "object",
					"properties": {
						"tanks_grant_capacity": { "$ref": "#/$defs/MessyBool", "default": true },
						"universal": { "$ref": "#/$defs/MessyBool", "default": false },
					},
					"required": [ "tanks_grant_capacity", "universal" ],
					"additionalProperties": false
				},
				"oxygen_base_capacity": { "type": "integer", "default": 30 },
				"weapons": {
					"type": "object",
					"properties": {
						"beam_distance": { "type": "integer", "default": 56 },
						"missile_damage_frozen_multiplier": { "type": "integer", "default": 1 },
						"power_bomb_base_damage": { "type": "integer", "default": 12 },
						"speedboost_damage": { "type": "integer", "default": 30 },
						"bomb_base_damage": { "type": "integer", "default": 3 },
						"beam_base_cooldown": { "type": "integer", "default": 9 },
						"bash_damage": { "type": "integer", "default": 10 },
						"stun_time_mooks": { "type": "integer", "default": 10 },
						"autofire_cooldown": { "type": "integer", "default": 3 },
						"stun_time_bosses": { "type": "integer", "default": 10 },
						"beam_speed": { "type": "number", "default": 5.0 },
						"shinespark_damage": { "type": "integer", "default": 30 },
						"charge_time": { "type": "integer", "default": 90 },
						
						"stun_bosses": { "$ref": "#/$defs/MessyBool", "default": false },
						"missile_charge_replace_ammo": { "$ref": "#/$defs/MessyBool", "default": false },
						"missile_autofire": { "$ref": "#/$defs/MessyBool", "default": false },
						"stun_mooks": { "$ref": "#/$defs/MessyBool", "default": false },
						"beam_autofire": { "$ref": "#/$defs/MessyBool", "default": true },
						"inherit_momentum": { "$ref": "#/$defs/MessyBool", "default": true },
						
						"bomb_scale_damage_from_beams": { "description": "type unknown", "default": 1 },
						"shinespark_damage_from_suits": { "description": "type unknown", "default": 0 },
						"charge_combo_ammo": { "description": "type unknown", "default": 1 },
					},
					"required": [
						"beam_distance", "missile_damage_frozen_multiplier", "power_bomb_base_damage",
						"speedboost_damage", "bomb_base_damage", "stun_bosses", "missile_charge_replace_ammo",
						"bomb_scale_damage_from_beams", "shinespark_damage_from_suits", "charge_combo_ammo",
						"beam_base_cooldown", "missile_autofire", "stun_mooks", "bash_damage", "stun_time_mooks",
						"autofire_cooldown", "beam_autofire", "stun_time_bosses", "inherit_momentum", "beam_speed",
						"shinespark_damage", "charge_time"
					],
					"additionalProperties": false
				},
				"energy": {
					"type": "object",
					"properties": {
						"hud_type": { "type": "integer", "default": 0 },
						"tanks_grant_capacity": { "$ref": "#/$defs/MessyBool", "default": true },
						"last_chance": { "$ref": "#/$defs/MessyBool", "default": true }
					},
					"required": [ "hud_type", "tanks_grant_capacity", "last_chance" ],
					"additionalProperties": false
				},
				"load_state": {
					"type": "integer",
					"default": 3
				},
				"movement": {
					"type": "object",
					"properties": {
						"walk_speed": { "type": "number", "default": 0.75 },
						"morph_speed": { "type": "number", "default": 0.75 },
						"air_speed": { "type": "number", "default": 0.75 },
						"walk_speed_max": { "type": "number", "default": 1.5 },
						"morph_speed_max": { "type": "number", "default": 1.5 },
						"air_speed_max": { "type": "number", "default": 1.5 },
						"gravity": { "type": "number", "default": 0.1 },
						"gravity_max": { "type": "number", "default": 3.5 },
						
						"enable_respin": { "$ref": "#/$defs/MessyBool", "default": false },
						"enable_downward_aiming": { "$ref": "#/$defs/MessyBool", "default": true },
						"enable_spider_boost": { "$ref": "#/$defs/MessyBool", "default": true },
						"enable_midair_morph": { "$ref": "#/$defs/MessyBool", "default": false },
						"enable_unmorph_jump": { "$ref": "#/$defs/MessyBool", "default": true },
						
						"allow_extra_jumps_in_liquids": { "$ref": "#/$defs/MessyBool", "default": false },
						"force_walljump_momentum": { "$ref": "#/$defs/MessyBool", "default": true },
						
						"speed_boost_walk_on_liquids": { "$ref": "#/$defs/MessyBool", "default": true },
						"speed_boost_bounce_on_liquids": { "$ref": "#/$defs/MessyBool", "default": true },
						
						"speed_keep": { "$ref": "#/$defs/MessyBool", "default": true },
						"speed_keep_airborne": { "$ref": "#/$defs/MessyBool", "default": true },
						"speed_keep_spider": { "$ref": "#/$defs/MessyBool", "default": true },
						"speed_auto_run": { "$ref": "#/$defs/MessyBool", "default": true },
						
						"screw_shot_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						"screw_bomb_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						
						"speed_boost_shot_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						"speed_boost_bomb_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						
						"bash_shot_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						"bash_bomb_blocks": { "$ref": "#/$defs/MessyBool", "default": false },
						
						"spin_jump_timing": { "description": "Type unknown", "default": 0 },
						"jump_power": { "type": "number", "default": 4.0 },
						"liquid_slowdown": { "type": "number", "default": 0.6 },
						"speed_boost_distance": { "type": "integer", "default": 20 },
						"knockback": {
							"type": "object",
							"properties": {
								"boosting_allowed": { "$ref": "#/$defs/MessyBool", "default": true },
								"boosting_force": { "type": "number", "default": 4.0 },
								"boosting_time": { "type": "integer", "default": 30 },
								"style": { "type": "integer", "minimum": 0, "maximum": 1, "default": 0 },
								"base_time": { "type": "integer", "default": 12 },
								"base_h_force": { "type": "number", "default": 4.0 },
								"base_v_force": { "type": "number", "default": 2.5 }
							},
							"required": [
								"boosting_allowed", "boosting_force", "boosting_time", "style", "base_time",
								"base_h_force", "base_v_force"
							],
							"additionalProperties": false
						}
						
					},
					"required": [
						"walk_speed", "enable_respin", "morph_speed_max", "gravity_max", "air_speed_max",
						"speed_boost_walk_on_liquids", "enable_downward_aiming", "force_walljump_momentum",
						"speed_keep_spider", "speed_auto_run", "spin_jump_timing", "enable_spider_boost",
						"jump_power", "gravity", "speed_boost_bounce_on_liquids", "enable_unmorph_jump",
						"liquid_slowdown", "speed_boost_shot_blocks", "knockback", "screw_shot_blocks",
						"enable_midair_morph", "speed_keep_airborne", "screw_bomb_blocks", "morph_speed",
						"walk_speed_max", "speed_boost_bomb_blocks", "allow_extra_jumps_in_liquids",
						"air_speed", "bash_bomb_blocks", "speed_keep", "bash_shot_blocks", "speed_boost_distance"
					]
				},
				"missiles": {
					"type": "array",
					"description": "Stats for the three missile types you can switch between. Default values are typical for basic missiles.",
					"items": {
						"type": "object",
						"properties": {
							"ammo_use": { "type": "integer", "default": 1 },
							"screen_limit": { "type": "integer", "default": 10 },
							"cooldown": { "type": "integer", "default": 18 },
							"speed_acceleration": { "type": "number", "default": 0.3 },
							"speed_max": { "type": "number", "default": 3.5 },
							"damage": { "type": "integer", "default": 8 },
							"speed_start": { "type": "number", "default": 0.5 },
						},
						"required": [
							"ammo_use", "screen_limit", "cooldown", "speed_acceleration",
							"speed_max", "damage", "speed_start"
						],
						"additionalProperties": false
					},
					"minItems": 3,
					"maxItems": 3
				},
				"items": {
					"type": "object",
					"properties": {
						"starting": {
							"type": "array",
							"items": { "type": "integer" }
						}
					},
					"required": [ "starting" ],
					"additionalProperties": false
				},
				"invincibility_frames": { "type": "integer", "default": 64 },
			},
			"required": [
				"ammo", "oxygen_base_capacity", "weapons", "energy", "load_state", "movement", "missiles", "items",
				"invincibility_frames"
			],
			"additionalProperties": false
		},
		
		"PROGRESSION_LOG": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"x": { "type": "integer" },
					"y": { "type": "integer" },
					"sector": { "type": "integer" },
					"room_id": { "type": "integer" },
					"item": { "type": "integer" },
					"area": { "type": "integer" },
				},
				"required": [ "x", "y", "sector", "room_id", "item", "area" ],
				"additionalProperties": false
			}
		
		},
		
		"GUNSHIP": {
			"type": "object",
			"properties": {
				"starting_landsites": { "type": "array", "default": [] },
				"recharge_enabled": { "$ref": "#/$defs/MessyBool", "default": true },
				"starting_position": { "type": "integer", "default": 0 },
				"starting_inventory": { "type": "array", "default": [] },
				"save_available": { "$ref": "#/$defs/MessyBool", "default": true },
				"map_scanner_link": { "$ref": "#/$defs/MessyBool", "default": false }
			},
			"required": [
				"starting_landsites", "recharge_enabled", "starting_position",
				"starting_inventory", "save_available", "map_scanner_link"
			],
			"additionalProperties": false
		},
		
		"ENEMY_DATA": {
			"type": "array",
			"description": "Each position in this array corresponds to an Enemy Id.",
			"items": {
				"type": "array",
				"description": "Each position in this array corresponds to an upgrade level for this enemy.",
				"items": {
					"type": "object",
					"properties": {
						"hp": { "type": "integer", "minimum": 1 },
						"damage": { "type": "integer" },
						"palette_data": {
							"type": "array",
							"description": "Each position in this array corresponds to an animation step(?) for this palette. Typically there is only one step.",
							"items": {
								"type": "array",
								"description": "This integer triplet describes three palette colors to use for the enemy.",
								"minItems": 3,
								"maxItems": 3,
								"items": {
									"type": "integer"
								}
							}
						}
					},
					"required": [ "hp", "damage", "palette_data" ],
					"additionalProperties": false
				}
			}
		},
		
		"ITEM_DATA": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"hidden": { "$ref": "#/$defs/MessyBool" },
					"parameters": {
						"type": "object",
						"description": "The exact format of each item_data object depends on the corresponding item."
					}
				},
				"required": [ "hidden", "parameters" ],
				"additionalProperties": false
			}
		},
		
		"GENERAL": {
			"type": "object",
			"properties": {
				"escape": {
					"type": "object",
					"properties": {
						"time": { "type": "integer" },
						"halfway_point": { "type": "integer" },
						"dynamic_music": { "$ref": "#/$defs/MessyBool" }
					},
					"required": [ "time", "halfway_point", "dynamic_music" ],
					"additionalProperties": false
				},
				"slim": { "$ref": "#/$defs/MessyBool" },
				"starting_spawn_point_id": { "type": "integer" },
				"gunship_hints": { "$ref": "#/$defs/MessyBool" },
				"gate_bosses": {
					"type": "array",
					"items": {
						"type": "integer"
					}
				}
			},
			"required": [ "escape", "slim", "starting_spawn_point_id", "gunship_hints", "gate_bosses" ],
			"additionalProperties": false
		},
		
		"GENERATION_DEBUG_LOG": {
			"type": "object",
			"description": "Freeform json object containing debug information. Created by enigma but not used by the game engine.",
			"properties": {
				"core_pool": {
					"type": "array",
					"items": { "type": "integer" }
				},
				"major_pool": {
					"type": "array",
					"items": { "type": "integer" }
				},
				"starting_items": {
					"type": "array",
					"items": { "type": "integer" }
				},
				"minor_pools": {
					"type": "array",
					"items": {
						"type": "array",
						"items": { "type": "integer" }
					}
				},
				"placed_items": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": { "type": "integer" },
							"room_id": { "type": "integer" },
							"old_val": { "type": "integer" },
							"new_val": { "type": "integer" }
						},
						"required": [ "id", "room_id", "old_val", "new_val" ],
						"additionalProperties": false
					}
				},
			},
			"$comment": "Everything here is optional, and it is good practice for an externally-edited map not to have built-in enigma debug logs, because its automatic generation process will necessarily be different or nonexistant.",
			"required": [],
			"additionalProperties": true
		},
		
		"CUTSCENES": { "type": "array" },
		"FLAGS": { "type": "array" },
		"EVENTS": { "type": "array" },
		"SYSTEM_PALETTES": { "type": "array" },
		"VALUES": { "type": "array" },
		
	},
	"required": [
		"MODES",
		"LOGS",
		"SECTORS",
		"TIMERS",
		"AREAS",
		"ROOMS",
		"HAZARDS",
		"GENERATION_DEBUG_LOG",
		"OBJECTIVES",
		"RULES",
		"LIQUIDS_DAMAGE",
		"SAMUS",
		"EVENTS",
		"SYSTEM_PALETTES",
		"VALUES",
		"PROGRESSION_LOG",
		"GUNSHIP",
		"ENEMY_DATA",
		"CUTSCENES",
		"FLAGS",
		"ITEM_DATA",
		"GENERAL"
	],
	"additionalProperties": false
}

